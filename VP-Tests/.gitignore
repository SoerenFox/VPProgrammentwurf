# Temporary/compressed files
*.gz
*.zip

# Editor backups and temp files
*~
*.swp
*.swo
*.tmp
*.bak
*.orig

# macOS / Windows
.DS_Store
Thumbs.db

# Visual Studio Code
.vscode/
*.code-workspace

# TeXstudio / TeXmaker / other LaTeX editors
*.txs
*.texpadtmp

# Build directories
_build/
build/
dist/

# latexmk and other tool artifacts
.latexmkrc

# Common output directories
out/

